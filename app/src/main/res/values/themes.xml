<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AirAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/air_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/air_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/air_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/air_exit</item>
    </style>

    <style name="Theme.AirDraw" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/air_bg</item>
        <item name="android:statusBarColor">@color/air_bg</item>
        <item name="android:navigationBarColor">@color/air_bg</item>
        <item name="android:colorAccent">@color/air_cyan</item>
        <item name="android:colorControlActivated">@color/air_cyan</item>
        <item name="android:windowAnimationStyle">@style/AirAnim</item>
    </style>
</resources>